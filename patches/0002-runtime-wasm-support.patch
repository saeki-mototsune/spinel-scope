+static mrb_bool sp_Fiber_alive(sp_Fiber*f){(void)f;return FALSE;}
+static sp_RbVal sp_Fiber_transfer(sp_Fiber*f,sp_RbVal val){(void)f;(void)val;sp_raise_cls("NotImplementedError","Fiber is not supported in this build");return sp_box_nil();}
