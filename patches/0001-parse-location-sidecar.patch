+    if (sf) { fwrite(source, 1, source_len, sf); fclose(sf); }
+  }
+
   /* Flatten AST to text */
   lines = NULL;
   line_count = 0;
@@ -1578,6 +1594,7 @@ int main(int argc, char **argv) {
