diff --git a/spinel_parse.c b/spinel_parse.c
index e195863..00f319d 100644
--- a/spinel_parse.c
+++ b/spinel_parse.c
@@ -28,6 +28,9 @@ static int line_count;
 static int line_cap;
 static int node_counter;
 
+/* ---- Location sidecar (SPINEL_AST_LOCATIONS) ---- */
+static FILE *g_loc_fp;
+
 static void out_add(const char *fmt, ...) {
   va_list ap;
   va_start(ap, fmt);
@@ -159,6 +162,10 @@ static int flatten(pm_node_t *node) {
   if (!node) return -1;
 
   int id = node_counter++;
