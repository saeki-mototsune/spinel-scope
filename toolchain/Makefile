# spinel visualize toolchain — builds web/wasm/ artifacts.
# Prereqs: toolchain/spinel-src submodule initialized + patches applied,
#          toolchain/emsdk installed. `source emsdk_env.sh` before running, or
#          use the emcc path below.
EMCC     ?= emsdk/upstream/emscripten/emcc
SRC       = spinel-src
OUT       = ../web/wasm
PRISM_DIR = $(SRC)/vendor/prism
PRISM_SRCS = $(wildcard $(PRISM_DIR)/src/*.c) $(wildcard $(PRISM_DIR)/src/util/*.c)

EMFLAGS = -O2 -sMODULARIZE=1 -sEXPORT_ES6=1 -sALLOW_MEMORY_GROWTH=1 \
          -sSUPPORT_LONGJMP=1 -sSTACK_SIZE=67108864 -sINVOKE_RUN=0 \
          -sEXIT_RUNTIME=1 -sEXPORTED_RUNTIME_METHODS=callMain,FS,ENV \
          -sENVIRONMENT=web,worker,node

all: $(OUT)/spinel_parse.mjs $(OUT)/spinel_analyze.mjs $(OUT)/spinel_codegen.mjs

$(OUT)/spinel_parse.mjs: $(SRC)/spinel_parse.c $(PRISM_SRCS) $(wildcard $(PRISM_DIR)/include/prism.h) $(wildcard $(PRISM_DIR)/include/prism/*.h)
	@mkdir -p $(OUT)
	$(EMCC) $(EMFLAGS) -I$(PRISM_DIR)/include -I$(PRISM_DIR)/src \
	  $(SRC)/spinel_parse.c $(PRISM_SRCS) -lm -o $@

# analyze1.c / codegen1.c are generated by the native bootstrap (make -C spinel-src).
$(OUT)/spinel_analyze.mjs: $(SRC)/build/analyze1.c $(SRC)/lib/sp_runtime.h
	@mkdir -p $(OUT)
	$(EMCC) $(EMFLAGS) -Wno-everything -I$(SRC)/lib $< -lm -o $@

$(OUT)/spinel_codegen.mjs: $(SRC)/build/codegen1.c $(SRC)/lib/sp_runtime.h
	@mkdir -p $(OUT)
	$(EMCC) $(EMFLAGS) -Wno-everything -I$(SRC)/lib $< -lm -o $@

clean:
	rm -rf $(OUT)
.PHONY: all clean

golden: all
	cd .. && test/golden/run.sh
.PHONY: golden
